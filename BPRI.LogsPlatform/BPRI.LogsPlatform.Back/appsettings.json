{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ExceptionLogs": "Server=.;Database=CatalogueLogsDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "LogsTable": { "TableName": "ExceptionLogs", "SchemaName": "dbo" },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "ExceptionHandling": {
    "ApplicationName": "BPRI.LogsPlatform.Back",
    "Cprj": "LogsPlatform",
    "File": { "Enabled": true, "Path": "logs/exceptions-.log" },
    "Database": { "Enabled": false },
    "Email": { "Enabled": false }
  }
}
