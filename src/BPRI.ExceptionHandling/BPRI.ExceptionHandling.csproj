<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BPRI.ExceptionHandling</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BPRI.ExceptionHandling</PackageId>
    <Version>2.0.0</Version>
    <Authors>BPRI</Authors>
    <Description>Middleware ASP.NET Core de gestion des exceptions : réponse JSON avec TraceId, logs Serilog vers fichier, SQL Server et e-mail.</Description>
    <PackageTags>exception;middleware;aspnetcore;serilog</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.Email" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\ErrorMail.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
